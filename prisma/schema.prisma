// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  phone          String?  @unique
  password       String
  address        String?
  profilePicture String?
  role           UserRole @default(customer)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  handymanProfile HandymanProfile?
  reviewsWritten  Review[]         @relation("ReviewerRelation")
  reviewsReceived Review[]         @relation("RevieweeRelation")
  reporterReports Report[]         @relation("reporterReports")
  reportedReports Report[]         @relation("reportedReports")
  warningsIssued  Warning[]        @relation("AdminWarnings")

  @@map("users")
}

// ─────────────────────────────────────────────
// SERVICE CATEGORY
// ─────────────────────────────────────────────

model ServiceCategory {
  id          String            @id @default(cuid())
  name        String            @unique
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  handymen    HandymanProfile[]

  @@map("service_categories")
}

// ─────────────────────────────────────────────
// HANDYMAN PROFILE
// ─────────────────────────────────────────────

model HandymanProfile {
  id                String             @id @default(cuid())
  userId            String             @unique
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId        String?
  category          ServiceCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  bio               String?
  skills            String?
  certificate       String?
  idCardImage       String?
  portfolioImage    String?
  availability      AvailabilityStatus @default(AVAILABLE)
  rating            Float              @default(0.0)
  totalReviews      Int                @default(0)
  isApproved        Boolean            @default(false)
  telegramUsername  String?
  yearsOfExperience Int?
  serviceArea       String?
  isPaused          Boolean            @default(false)
  pausedUntil       DateTime?          // set when paused; null = indefinite (ban)
  isBanned          Boolean            @default(false)
  warningCount      Int                @default(0)

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  reviews           Review[]
  reports           Report[]
  warnings          Warning[]

  @@map("handyman_profiles")
}

// ─────────────────────────────────────────────
// WARNING
// ─────────────────────────────────────────────

model Warning {
  id          String          @id @default(cuid())

  handymanId  String
  handyman    HandymanProfile @relation(fields: [handymanId], references: [id], onDelete: Cascade)

  // The admin who issued the warning
  adminId     String?
  admin       User?           @relation("AdminWarnings", fields: [adminId], references: [id], onDelete: SetNull)

  // Optional link to the report that triggered this warning
  reportId    String?

  note        String?
  createdAt   DateTime        @default(now())

  @@map("warnings")
}

// ─────────────────────────────────────────────
// REVIEW
// ─────────────────────────────────────────────

model Review {
  id         String          @id @default(cuid())

  reviewerId String
  reviewer   User            @relation("ReviewerRelation", fields: [reviewerId], references: [id], onDelete: Cascade)

  handymanId String
  handyman   HandymanProfile @relation(fields: [handymanId], references: [id], onDelete: Cascade)

  revieweeId String
  reviewee   User            @relation("RevieweeRelation", fields: [revieweeId], references: [id], onDelete: Cascade)

  rating    Int
  comment   String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([reviewerId, handymanId])
  @@map("reviews")
}

// ─────────────────────────────────────────────
// REPORT
// ─────────────────────────────────────────────

model Report {
  id          String          @id @default(cuid())
  handymanId  String
  handyman    HandymanProfile @relation(fields: [handymanId], references: [id], onDelete: Cascade)
  reporterId  String?
  reporter    User?           @relation("reporterReports", fields: [reporterId], references: [id], onDelete: SetNull)
  reportedId  String?
  reported    User?           @relation("reportedReports", fields: [reportedId], references: [id], onDelete: SetNull)

  reason      ReportType
  description String
  status      ReportStatus    @default(PENDING)

  // Proof images uploaded by the reporter (stored as base64 data URLs)
  proofImages String[]        @default([])

  // Admin note added when actioning this report
  actionNote  String?

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("reports")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserRole {
  customer
  handyman
  admin
}

enum AvailabilityStatus {
  AVAILABLE
  BUSY
  UNAVAILABLE
}

enum ReportType {
  FRAUD
  INAPPROPRIATE_BEHAVIOR
  SPAM
  FAKE_REVIEW
  OTHER
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}
