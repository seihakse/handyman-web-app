# Database
DATABASE_URL="postgresql://handyman_user:securepassword@localhost:5432/handyman_db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-here-make-it-32-characters-long"

# Optional: For password hashing
BCRYPT_SALT_ROUNDS=12

ADMIN_EMAIL=admin@handypro.com
ADMIN_PASSWORD_HASH=your_pre_hashed_password_here

# Cloudinary — image uploads (profile pictures, certificates, portfolio)
# 1. Sign up free at https://cloudinary.com
# 2. Dashboard → Settings → Upload → Add upload preset → set to "Unsigned"
# 3. Replace the values below with your actual cloud name and preset name
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset
